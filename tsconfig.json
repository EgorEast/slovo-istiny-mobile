{
  // Relative path on purpose: expo's package.json "exports" map does not expose the tsconfig
  // subpath, so require.resolve-based tooling (steiger/tsconfck) cannot resolve "expo/tsconfig.base". See docs/decisions.md
  "extends": "./node_modules/expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "entities/*": ["./src/entities/*"],
      "features/*": ["./src/features/*"],
      "pages/*": ["./src/pages/*"],
      "shared/*": ["./src/shared/*"],
      "widgets/*": ["./src/widgets/*"]
    },
    "skipLibCheck": true,
    "types": ["jest", "node"]
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.ts",
    "__mocks__",
    "public"
  ]
}
